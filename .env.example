# Backend-only configuration. Copy to .env at the repository root.
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant
POSTGRES_PASSWORD=assistant
# demo (no key), gemini or deepseek
AI_MODE=demo
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional: override the fast model for planning; a reasoning model may be slower and cost more.
DEEPSEEK_PLANNER_MODEL=
# Optional second AI call to review proposals (adds latency and token usage).
AI_REVIEW_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Generate your own random token before enabling the companion.
AGENT_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Demo only: pretend the app starts at this moment (keep the UTC offset), e.g. 2026-10-13T08:00:00-07:00
DEMO_NOW=
